    <string name="education_title">Básico sobre NFC</string>
    <string name="education_close_content_description">Fechar básico sobre NFC</string>
    <string name="education_what_is_nfc_title">O que é NFC?</string>
    <string name="education_what_is_nfc_body">O NFC funciona apenas a uma distância muito curta — poucos centímetros. Encostar a zona de toque do celular diretamente no aparelho e mantê-lo parado garante a leitura mais confiável.</string>
    <string name="education_faq_antenna_location">Onde fica a antena no meu celular?</string>
    <string name="education_faq_antenna_location_answer">Geralmente perto da parte superior traseira, próxima à câmera principal — o TapSense mostra o local exato para o seu modelo na tela Meu Celular.</string>
    <string name="education_faq_tap_tag">Como eu toco uma tag NFC?</string>
    <string name="education_faq_tap_tag_answer">Encoste a zona de toque do celular diretamente na tag e mantenha-a parada por um ou dois segundos.</string>
    <string name="education_faq_pay_vs_scan">Pagamento por aproximação vs. leitura de tag</string>
    <string name="education_faq_pay_vs_scan_answer">O pagamento por aproximação se comunica com um terminal de pagamento seguro; a leitura de tag lê um pequeno chip passivo. Ambos usam a mesma antena e zona de toque.</string>
    <string name="education_faq_why_fail">Por que um toque pode falhar</string>
    <string name="education_faq_why_fail_answer">Capas grossas, acessórios magnéticos, bateria fraca ou simplesmente errar a zona de toque são as causas mais comuns.</string>

