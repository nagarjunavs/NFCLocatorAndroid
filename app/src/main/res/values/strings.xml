    <!-- Education -->
    <string name="education_title">NFC basics</string>
    <string name="education_close_content_description">Close NFC basics</string>
    <string name="education_what_is_nfc_title">What is NFC?</string>
    <string name="education_what_is_nfc_body">NFC works only at very close range — a few centimeters. Placing your phone\'s tap area directly against the device and holding it still gives the most reliable read.</string>
    <string name="education_faq_antenna_location">Where is the antenna on my phone?</string>
    <string name="education_faq_antenna_location_answer">Usually near the upper back, close to the main camera — TapSense shows the exact spot for your model on the My Phone screen.</string>
    <string name="education_faq_tap_tag">How do I tap an NFC tag?</string>
    <string name="education_faq_tap_tag_answer">Hold your phone\'s tap zone directly against the tag and keep it steady for a second or two.</string>
    <string name="education_faq_pay_vs_scan">Tap-to-pay vs. tag scanning</string>
    <string name="education_faq_pay_vs_scan_answer">Tap-to-pay talks to a secure payment terminal; tag scanning reads a small passive chip. Both use the same antenna and tap zone.</string>
    <string name="education_faq_why_fail">Why a tap can fail</string>
    <string name="education_faq_why_fail_answer">Thick cases, magnetic accessories, low battery, or simply missing the tap zone are the most common causes.</string>

