    <string name="my_phone_tab_back">पीछे</string>
    <string name="my_phone_tab_front">सामने</string>
    <string name="my_phone_not_applicable">लागू नहीं</string>
    <string name="my_phone_front_body">NFC एंटीना इस फ़ोन के सामने वाले हिस्से पर नहीं है. अनुशंसित टैप ज़ोन देखने के लिए पीछे पर स्विच करें.</string>
    <string name="my_phone_front_banner">ज़्यादातर फ़ोन में NFC एंटीना पिछले पैनल पर, ऊपरी हिस्से या कैमरे के पास होता है.</string>
    <string name="my_phone_view_back_placement">पीछे की स्थिति देखें</string>
    <string name="my_phone_nfc_unsupported_body">इस डिवाइस में NFC हार्डवेयर नहीं है, इसलिए दिखाने के लिए कोई टैप ज़ोन नहीं है.</string>
    <string name="my_phone_zone_description">NFC एंटीना / अनुशंसित संपर्क क्षेत्र. इस क्षेत्र को सीधे रीडर या टैग पर लगाएं.</string>
    <string name="my_phone_case_warning">मोटे केस, मैग्नेटिक वॉलेट, और मेटल प्लेट NFC प्रदर्शन को कम कर सकते हैं.</string>
