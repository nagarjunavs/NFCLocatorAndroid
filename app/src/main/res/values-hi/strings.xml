    <string name="tap_guide_step_of">चरण %1$d, कुल %2$d में से</string>
    <string name="tap_guide_next">अगला</string>
    <string name="tap_guide_close_content_description">टैप गाइड बंद करें</string>
    <string name="tap_guide_step1_title">अपना टैप ज़ोन पहचानें</string>
    <string name="tap_guide_step1_body">यह वही हिस्सा है जो आपकी होम और मेरा फ़ोन स्क्रीन पर हाइलाइट किया गया है.</string>
    <string name="tap_guide_step2_title">रीडर को सक्रिय करें</string>
    <string name="tap_guide_step2_body">अपने फ़ोन को कुछ सेंटीमीटर पास लाएं — ज़्यादातर रीडर अपने आप सक्रिय हो जाते हैं.</string>
    <string name="tap_guide_step3_title">हाइलाइट किए गए हिस्से को रीडर पर लगाए रखें</string>
    <string name="tap_guide_step3_body">1–2 सेकंड तक संपर्क स्थिर रखें. पुष्टि के लिए वाइब्रेशन या आवाज़ का इंतज़ार करें.</string>
    <string name="tap_guide_step4_title">पुष्टि का इंतज़ार करें</string>
    <string name="tap_guide_step4_body">जब टैप सफल होता है, तो ज़्यादातर रीडर बीप करते हैं, चमकते हैं, या आपके फ़ोन को वाइब्रेट करते हैं.</string>
    <string name="tap_guide_step5_title">असल में आज़माकर देखें</string>
    <string name="tap_guide_step5_body">यह पुष्टि करने के लिए अभी टैप टेस्ट चलाएं कि आपका टैप ज़ोन असली NFC टैग या रीडर के साथ काम करता है.</string>
    <string name="tap_guide_step5_action">टैप टेस्ट चलाएं</string>

