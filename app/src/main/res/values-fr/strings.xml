    <string name="education_title">Les bases du NFC</string>
    <string name="education_close_content_description">Fermer les bases du NFC</string>
    <string name="education_what_is_nfc_title">Qu\'est-ce que le NFC ?</string>
    <string name="education_what_is_nfc_body">Le NFC ne fonctionne qu\'à très courte portée — quelques centimètres. Placer la zone de contact de votre téléphone directement contre l\'appareil et la maintenir immobile garantit la lecture la plus fiable.</string>
    <string name="education_faq_antenna_location">Où se trouve l\'antenne sur mon téléphone ?</string>
    <string name="education_faq_antenna_location_answer">Généralement près du haut de l\'arrière, à côté de l\'appareil photo principal — TapSense indique l\'emplacement exact pour votre modèle sur l\'écran Mon téléphone.</string>
    <string name="education_faq_tap_tag">Comment toucher un tag NFC ?</string>
    <string name="education_faq_tap_tag_answer">Placez la zone de contact de votre téléphone directement contre le tag et maintenez-la immobile pendant une ou deux secondes.</string>
    <string name="education_faq_pay_vs_scan">Paiement sans contact vs lecture de tag</string>
    <string name="education_faq_pay_vs_scan_answer">Le paiement sans contact communique avec un terminal de paiement sécurisé ; la lecture de tag lit une petite puce passive. Les deux utilisent la même antenne et zone de contact.</string>
    <string name="education_faq_why_fail">Pourquoi un contact peut échouer</string>
    <string name="education_faq_why_fail_answer">Les coques épaisses, accessoires magnétiques, la batterie faible, ou simplement rater la zone de contact sont les causes les plus courantes.</string>

